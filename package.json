{
  "name": "nikhil-yarra-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-cases.mjs",
    "preview": "vite preview",
    "build:pages": "tsc -b && vite build --base=/ny-portfolio/ && node scripts/build-cases.mjs",
    "audit:build": "node --experimental-strip-types scripts/audit-build.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "gsap": "latest",
    "lenis": "latest",
    "three": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "latest"
  }
}
